{
  "services": {
    "ai-career-navigator": {
      "root": ".",
      "framework": "nextjs",
      "buildCommand": "npm ci && npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "ai-career-navigator"
      }
    }
  ]
}
