# AI keys — server-side only. Never exposed to the browser.
# Works with any OpenAI-compatible endpoint (OpenAI, Azure, OpenRouter, Groq, Together, local Ollama, etc.)
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: explicit provider switch (openai | groq | openrouter)
AI_PROVIDER=openai

# Google OAuth (optional — "Continue with Google" button)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Local redirect URI:      http://localhost:3000/api/auth/google/callback
# Production redirect URI: https://YOUR-DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Optional: override redirect (e.g. behind a proxy or deployed domain)
# GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/auth/google/callback

# Demo Google sign-in (no keys needed): /api/auth/google?demo=1 signs in this user.
# Set NEXT_PUBLIC_GOOGLE_DEMO=1 to also show the demo button on the login page.
# GOOGLE_DEMO_EMAIL=demo.student@gmail.com
# GOOGLE_DEMO_NAME=Demo Student
# GOOGLE_DEMO_SEED_PROFILE=1
# NEXT_PUBLIC_GOOGLE_DEMO=1

# Storage (optional — for Vercel/Render deployments)
# Local dev needs nothing: accounts are stored in ./data/*.json
# On Vercel (serverless) or Render free tier (ephemeral disk) use a free
# Upstash Redis so accounts survive restarts: https://upstash.com
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXX...
# Override where JSON files are written (persistent-disk servers only)
# DATA_DIR=/var/data

# Public app config
NEXT_PUBLIC_APP_NAME=AI Career Navigator
NEXT_PUBLIC_APP_URL=http://localhost:3000
